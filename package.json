{
  "name": "aura-os-v1",
  "version": "1.0.0",
  "description": "Aura OS - Intelligent Audio Production Environment",
  "main": "backend/server.js",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.7.2",
    "axios": "^1.6.0",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node backend/server.js",
    "server:dev": "npm run server:dev --prefix backend",
    "dev": "concurrently \"npm run server:dev --prefix backend\" \"npm start\"",
    "lint": "eslint src/ --ext .js,.jsx",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
